# name: test/sql/path_finding/heterogeneous_quantified_edge.test
# description: A quantified edge over an edge table between two different vertex tables is rejected by the binder instead of raising an internal error (cwida/duckpgq-extension#358)
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE p(id INT PRIMARY KEY);

statement ok
CREATE TABLE o(id INT PRIMARY KEY);

statement ok
CREATE TABLE w(pid INT, oid INT);

statement ok
INSERT INTO p VALUES (1);

statement ok
INSERT INTO o VALUES (10), (11);

statement ok
INSERT INTO w VALUES (1, 11);

statement ok
CREATE PROPERTY GRAPH g VERTEX TABLES (p, o)
EDGE TABLES (w SOURCE KEY (pid) REFERENCES p (id) DESTINATION KEY (oid) REFERENCES o (id));

statement error
SELECT * FROM GRAPH_TABLE (g MATCH (x:p)-[r:w]->{1,2}(y:o) COLUMNS (x.id AS a, y.id AS b));
----
Binder Error: Path-finding over edge table w is not supported

statement error
SELECT * FROM GRAPH_TABLE (g MATCH x = ANY SHORTEST (x1:p)-[r:w]->{1,2}(y:o) COLUMNS (x1.id AS a, y.id AS b, element_id(x) AS e));
----
Binder Error: Path-finding over edge table w is not supported

statement error
SELECT * FROM GRAPH_TABLE (g MATCH (y:o)<-[r:w]-{1,2}(x:p) COLUMNS (x.id AS a, y.id AS b));
----
Binder Error: Path-finding over edge table w is not supported

statement error
SELECT * FROM GRAPH_TABLE (g MATCH (x:p)-[r:w]-{1,3}(y:o) COLUMNS (x.id AS a, y.id AS b));
----
Binder Error: Path-finding over edge table w is not supported

# The database is still usable after the error
query I
SELECT count(*) FROM w;
----
1

# Without a quantifier, or with {1,1}, the edge is a plain join and still works
query II
SELECT * FROM GRAPH_TABLE (g MATCH (x:p)-[r:w]->(y:o) COLUMNS (x.id AS a, y.id AS b));
----
1	11

query II
SELECT * FROM GRAPH_TABLE (g MATCH (x:p)-[r:w]->{1,1}(y:o) COLUMNS (x.id AS a, y.id AS b));
----
1	11
